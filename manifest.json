{
  "manifest_version": 3,
  "name": "Make AIs RTL",
  "version": "2.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_ltr16.png",
      "48": "icons/icon_ltr48.png",
      "128": "icons/icon_ltr128.png"
    }
  },
  "icons": {
    "16": "icons/icon_ltr16.png",
    "48": "icons/icon_ltr48.png",
    "128": "icons/icon_ltr128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["sites.js", "content.js"]
    }
  ]
}
