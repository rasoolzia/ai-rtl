{
  "manifest_version": 3,
  "name": "Make AIs RTL",
  "version": "2.0",
  "description": "Add RTL support to popular AI chat interfaces while keeping code blocks LTR.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_default16.png",
      "48": "icons/icon_default48.png",
      "128": "icons/icon_default128.png"
    },
    "default_title": "Make AIs RTL"
  },
  "icons": {
    "16": "icons/icon_ltr16.png",
    "48": "icons/icon_ltr48.png",
    "128": "icons/icon_ltr128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*"
      ],
      "js": ["sites.js", "content.js"]
    }
  ]
}
